:80 {

  # -------------------------
  # Frontend assets (MUST be first)
  # -------------------------
  handle_path /assets/* {
    reverse_proxy frontend:80
  }

  # -------------------------
  # Backend API
  # -------------------------
  handle_path /api/* {
    reverse_proxy api:8000
  }

  # -------------------------
  # Keycloak
  # -------------------------
  handle_path /auth/* {
    reverse_proxy keycloak:8080
  }

  # -------------------------
  # Grafana
  # -------------------------
  handle_path /grafana/* {
    reverse_proxy grafana:3000
  }

  # -------------------------
  # Prefect
  # -------------------------
  handle_path /prefect/* {
    reverse_proxy prefect:4200
  }

  # -------------------------
  # Frontend (catch-all)
  # -------------------------
  handle {
    reverse_proxy frontend:80
  }
}

[Unit]
Description=ResidencyFlow Production Platform
Documentation=https://github.com/yourusername/residencyflow
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/residencyflow
EnvironmentFile=/opt/residencyflow/.env.prod
ExecStartPre=/usr/bin/docker-compose -f /opt/residencyflow/docker-compose.prod.yml pull
ExecStart=/usr/bin/docker-compose -f /opt/residencyflow/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker-compose -f /opt/residencyflow/docker-compose.prod.yml down
ExecReload=/usr/bin/docker-compose -f /opt/residencyflow/docker-compose.prod.yml restart
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=60

# Security
User=residencyflow
Group=residencyflow
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=residencyflow

[Install]
WantedBy=multi-user.target

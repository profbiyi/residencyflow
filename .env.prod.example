# Database
POSTGRES_USER=residency
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=residencyflow

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# MinIO (S3-compatible storage)
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_HOSTNAME=auth.yourdomain.com

# Keycloak OIDC (for API authentication)
KEYCLOAK_URL=https://auth.yourdomain.com
KEYCLOAK_REALM=residencyflow
KEYCLOAK_CLIENT_ID=residencyflow-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_ADMIN_CLIENT_SECRET

# API
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS_MIN
ENVIRONMENT=production

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Domain (for Caddy TLS)
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
AUTH_DOMAIN=auth.yourdomain.com
MONITOR_DOMAIN=monitor.yourdomain.com
PREFECT_DOMAIN=prefect.yourdomain.com
